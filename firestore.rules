rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'rizramadhan975@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Admins Collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // Global Pricing Rules
    match /pricing/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Vouchers Collection
    match /vouchers/{voucherId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Servers Collection (Including Unlimited GB Panels)
    match /servers/{serverId} {
      allow get: if isSignedIn() && (resource.data.ownerEmail == request.auth.token.email || isAdmin());
      allow list: if isSignedIn() && (resource.data.ownerEmail == request.auth.token.email || isAdmin());
      allow write: if isAdmin();
    }

    // Connection test document
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
