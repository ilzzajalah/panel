{
   "name": "denia",
   "version": "0.2.0-beta.19",
   "description": "A simple WhatsApp bot built on Baileys",
   "main": "index.js",
   "type": "module",
   "scripts": {
      "start": "NODE_ENV=production MALLOC_ARENA_MAX=2 node --max-old-space-size=256 --expose-gc index.js",
      "fix": "node scripts/ensure-deps.mjs",
      "start:pm2": "pm2 start app.config.cjs"
   },
   "keywords": [
      "automation",
      "base",
      "baileys",
      "bot",
      "js-whatsapp",
      "multi-device",
      "whatsapp",
      "whatsapp-bot"
   ],
   "author": "Sairi",
   "license": "MIT",
   "dependencies": {
      "@whiskeysockets/baileys": "7.0.0-rc14",
      "@ffmpeg-installer/ffmpeg": "^1.1.0",
      "@hapi/boom": "^10.0.1",
      "@napi-rs/image": "^1.12.0",
      "cheerio": "^1.0.0",
      "fflate": "^0.8.2",
      "file-type": "21.3.4",
      "lru-cache": "^10.0.0",
      "p-queue": "^8.0.0",
      "pino": "^9.0.0",
      "qrcode": "~1.5.4",
      "sharp": "^0.34.2",
      "undici": "^6.0.0",
      "yt-search": "^2.13.1"
   },
   "packageManager": "yarn@1.22.22",
   "engines": {
      "node": ">=20.18.1"
   }
}
