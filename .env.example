# ==========================================
# AETHERPANEL ENVIRONMENT CONFIGURATION
# ==========================================

# Base App URL
APP_URL="http://localhost:3000"
PORT=3000

# Database Configuration (PostgreSQL in production VPS)
DATABASE_URL="postgresql://aether:aether_secure_password_2026@localhost:5432/aetherpanel?schema=public"

# Redis Queue & PubSub
REDIS_URL="redis://localhost:6379"

# Security & Encryption
JWT_SECRET="generate_random_secret_with_openssl_rand_hex_32"
ENCRYPTION_KEY="32_character_long_secret_key_aes256"

# BuatQris Open API Configuration (https://api.buatqris.site)
# Ambil dari: Dasbor BuatQris -> Akun & Open API
BUATQRIS_ACCOUNT_ID="ACC-YOUR-ACCOUNT-ID"
BUATQRIS_SECRET_TOKEN="sec_tok_your_secret_token"
BUATQRIS_SIGNING_SECRET="sign_sec_your_webhook_signing_secret"
# Mode: 'live' (Uang Asli), 'sandbox' (Test API dengan test=1), 'mock' (Testing lokal tanpa panggilan keluar)
BUATQRIS_MODE="mock"

# Node Daemon Token (Harus cocok antara Panel dan Daemon di tiap Node)
DAEMON_TOKEN="aether_daemon_secret_token_node_1"

# 9router Gateway Integration (Opsional untuk reverse proxy & custom domain)
ROUTER_ENDPOINT="https://api.9router.com"
ROUTER_API_KEY=""

# SMTP Email Configuration (Nodemailer)
SMTP_HOST="smtp.mailgun.org"
SMTP_PORT=587
SMTP_USER="postmaster@yourdomain.com"
SMTP_PASS="smtp_password"
SMTP_FROM="Aether Hosting <noreply@yourdomain.com>"
